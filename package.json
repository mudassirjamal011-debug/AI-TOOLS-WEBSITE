{
  "name": "toolnova-ai",
  "version": "1.0.0",
  "private": true,
  "description": "ToolNova AI \u2014 powerful AI & online tools: image, PDF, text, file and developer utilities that run in your browser.",
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-force-exit --import ./tests/register-loader.mjs tests/*.test.mjs",
    "test:unit": "node --test --test-force-exit tests/text.test.mjs tests/image.test.mjs tests/pdf.test.mjs tests/hash.test.mjs",
    "test:routes": "node --test --test-force-exit --import ./tests/register-loader.mjs tests/routes.test.mjs tests/catalog.test.mjs",
    "test:ui": "node --test --test-force-exit --import ./tests/register-loader.mjs tests/dom.test.mjs tests/dom-files.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.49.0",
    "next": "15.5.27",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
