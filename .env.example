# ---------------------------------------------------------------------------
# ToolNova AI — environment configuration
#
# Copy this file to `.env.local` and fill in the values you need.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# Public
# ---------------------------------------------------------------------------
# Absolute URL of the deployment. Used for canonical links, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ads (optional)
# ---------------------------------------------------------------------------
# Set to "true" once you have inserted your ad network code in AdManager
# (components/ui/AdPlaceholder.tsx). Until then the slots stay empty and
# labelled, so the layout never shows a fake advert.
NEXT_PUBLIC_ADS_ENABLED=false
# Google AdSense client id, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=

# AI tools (server-side only — never exposed to the browser)
# ---------------------------------------------------------------------------
# If AI_API_KEY is empty, the AI tools display:
#   "AI service is not configured yet."
# and do not generate anything.
AI_API_KEY=
# Any OpenAI-compatible chat completions endpoint:
#   OpenAI     https://api.openai.com/v1
#   Groq       https://api.groq.com/openai/v1
#   OpenRouter https://openrouter.ai/api/v1
#   Ollama     http://localhost:11434/v1
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_MODEL=gpt-4o-mini
# Optional label, used only in server responses.
AI_API_PROVIDER=openai-compatible

# Contact form (server-side only)
# ---------------------------------------------------------------------------
# Option 1 — Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=ToolNova AI <onboarding@resend.dev>
# Option 2 — generic webhook (Slack, Zapier, Make, n8n…)
CONTACT_WEBHOOK_URL=

# Future admin / database (not required today)
# ---------------------------------------------------------------------------
# DATABASE_URL=
# ADMIN_API_TOKEN=
